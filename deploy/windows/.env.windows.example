# Copy this file to .env.windows only when the real file does not already exist.
# Never overwrite an existing .env.windows during restart or upgrade. Keep it private.
# The current cloud MySQL connection uses TLS without certificate verification.
QMS_DB_URL=jdbc:mysql://171.35.40.79:3306/qms?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&sslMode=REQUIRED
QMS_DB_USERNAME=qms_app
QMS_DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

# Generate with the Windows PowerShell 5.1-compatible command in WINDOWS_DEPLOYMENT.md.
# Keep this unchanged between restarts, or all existing login tokens become invalid.
QMS_LOCAL_LOGIN_JWT_SECRET=REPLACE_WITH_BASE64_32_BYTE_SECRET

SERVER_PORT=8080
QMS_LOG_LEVEL=INFO
QMS_LOG_MAX_FILE_SIZE=20MB
QMS_LOG_MAX_HISTORY=14
QMS_LOG_TOTAL_SIZE_CAP=1GB

# First startup initializes admin in customer-b if its password is not already set.
# After a successful first login, remove these three lines from .env.windows.
QMS_BOOTSTRAP_TENANT_CODE=customer-b
QMS_BOOTSTRAP_ADMIN_USERNAME=admin
QMS_BOOTSTRAP_ADMIN_PASSWORD=Admin@2026

# Flying-probe telemetry gateway: uncomment both lines in the real .env.windows.
# Use an ACTIVE QMS tenant code. Keep the real token private and do not reuse the JWT secret.
# QMS_GATEWAY_SHARED_TOKEN=REPLACE_WITH_SHARED_TOKEN
# QMS_GATEWAY_TELEMETRY_TENANT_CODE=REPLACE_WITH_ACTIVE_TENANT_CODE

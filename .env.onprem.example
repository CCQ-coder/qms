# One independent file and deployment directory per customer. Do not reuse these secrets between customers.
MYSQL_DATABASE=qms
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password-kept-for-database-administration

QMS_DB_URL=jdbc:mysql://mysql:3306/qms?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
QMS_DB_USERNAME=qms_app
QMS_DB_PASSWORD=replace-with-a-separate-long-random-application-password
QMS_GATEWAY_SHARED_TOKEN=replace-with-a-separate-long-random-gateway-secret

# QMS-managed username/password login. The JWT secret must be Base64-encoded and decode to at least 32 bytes.
QMS_SECURITY_DEVELOPMENT_MODE=false
QMS_LOCAL_PASSWORD_LOGIN_ENABLED=true
QMS_LOCAL_LOGIN_JWT_SECRET=replace-with-a-base64-encoded-32-byte-or-longer-random-secret
QMS_LOCAL_LOGIN_TOKEN_TTL_MINUTES=480

# First QMS tenant and administrator. The password is stored as a BCrypt hash and is used only if the account does not already exist.
QMS_BOOTSTRAP_TENANT_CODE=customer-a
QMS_BOOTSTRAP_TENANT_NAME=客户 A PCB 工厂
QMS_BOOTSTRAP_ADMIN_USERNAME=qms-admin
QMS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# 标特福旧版 WorkingMonitor.exe Hessian 兼容接口。留空时接口仍存在，但拒绝所有来源。
# 此租户必须是上述现场设备所属的 QMS 租户，且与设备映射中的 machineName 对应。
QMS_BTF_HESSIAN_ALLOWED_IPS=
QMS_BTF_HESSIAN_TENANT_CODE=customer-a

# 设备秒级遥测容量策略：原始快照短期留存，分钟/小时汇总用于长期趋势。
QMS_EQUIPMENT_TELEMETRY_RETENTION_ENABLED=true
QMS_EQUIPMENT_TELEMETRY_RAW_RETENTION_DAYS=7
QMS_EQUIPMENT_TELEMETRY_MINUTE_RETENTION_DAYS=365

# Put TLS in the customer's reverse proxy or load balancer. Bind to a private interface where possible.
QMS_WEB_BIND_ADDRESS=0.0.0.0
QMS_WEB_PORT=8080

# API files persist in the api-logs volume. Docker also retains bounded console logs for every service.
QMS_LOG_LEVEL=INFO
QMS_LOG_MAX_FILE_SIZE=20MB
QMS_LOG_MAX_HISTORY=14
QMS_LOG_TOTAL_SIZE_CAP=1GB

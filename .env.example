# MySQL
MYSQL_DATABASE=qms
MYSQL_USER=qms
MYSQL_PASSWORD=change-me-before-deployment
MYSQL_ROOT_PASSWORD=replace-with-a-separate-long-root-password

# QMS application
QMS_DB_URL=jdbc:mysql://mysql:3306/qms?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
QMS_DB_USERNAME=qms
QMS_DB_PASSWORD=change-me-before-deployment

# Customer B gateway: must be the same secret configured on the local gateway
QMS_GATEWAY_SHARED_TOKEN=c_pC9P81rmLzm4b6T4EbEtvLfdNILBdikRj5oCL9Ae0

# 标特福旧版 WorkingMonitor.exe Hessian 兼容接口。留空时拒绝所有请求。
QMS_BTF_HESSIAN_ALLOWED_IPS=10.20.169.142
# 旧协议没有租户字段；生产部署请明确绑定现场设备所属租户。
QMS_BTF_HESSIAN_TENANT_CODE=demo-pcb

# 设备秒级遥测容量策略：原始快照短期留存，分钟/小时汇总用于长期趋势。
QMS_EQUIPMENT_TELEMETRY_RETENTION_ENABLED=true
QMS_EQUIPMENT_TELEMETRY_RAW_RETENTION_DAYS=7
QMS_EQUIPMENT_TELEMETRY_MINUTE_RETENTION_DAYS=365
